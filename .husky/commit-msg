#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Enforce issue-ID commit message format for fix/test/refactor/chore commits.
# Pattern: (fix|test|chore|refactor)(scope)?: #ID description
# IDs: 01-001 through 11-011, N-001..N-003, R-001..R-999

MSG=$(cat "$1")
# The SUBJECT decides the type, not the body. `grep -oP '^(fix|…)'` over the
# whole message matches the start of ANY line, so a docs: commit whose body
# happened to contain a line beginning "test-frontend gains a check" was
# classified as a test commit and blocked. Anchor to the first line only.
# `|| true` is load-bearing. husky runs this hook as `sh -e "$s"`, so a grep
# that matches NOTHING returns 1 and aborts the whole hook — meaning every
# docs:/ci:/feat:/style: commit failed with "commit-msg script failed (code 1)"
# for the sole reason that it was not a fix/test/chore/refactor commit. The
# check that was meant to wave those through was killing them.
TYPE=$(head -1 "$1" | grep -oP '^(fix|test|chore|refactor)' || true)

if [ -z "$TYPE" ]; then
  exit 0  # build:, ci:, docs:, style:, perf: are free-form
fi

# The backlog is the AUTHORITY this hook validates against. If it is absent
# there is nothing to validate an ID against, and demanding one anyway blocks
# every fix/test/chore/refactor commit in the repository while offering no way
# to satisfy it. The hook already says as much further down — "cleanup-backlog.md
# not found — skipping ID verification" — but that check ran AFTER the format
# check, so it could never be reached. Checked first now.
BACKLOG="$(git rev-parse --show-toplevel)/audit/cleanup-backlog.md"
if [ ! -f "$BACKLOG" ]; then
  exit 0
fi

# Check for the #ID pattern
if ! echo "$MSG" | grep -qP '#([0-9]{2}-[0-9]{3}|[NR]-[0-9]{3})'; then
  echo ""
  echo "❌  Commit blocked: $TYPE commits require a backlog issue ID."
  echo "    Expected format: $TYPE(scope): #01-001 description"
  echo "    ID must be from audit/cleanup-backlog.md"
  echo ""
  exit 1
fi

# Extract the ID and verify it exists in the backlog
ID=$(echo "$MSG" | grep -oP '#([0-9]{2}-[0-9]{3}|[NR]-[0-9]{3})' | head -1 | tr -d '#' || true)

if ! grep -q "| $ID |" "$BACKLOG"; then
  echo ""
  echo "❌  Commit blocked: issue ID #$ID not found in audit/cleanup-backlog.md"
  echo "    Check the ID and re-commit."
  echo ""
  exit 1
fi

exit 0
