# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Configuration
DB_NAME=uchqun
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# CORS Configuration (PL-002, PL-008)
# REQUIRED IN PRODUCTION — comma-separated list of frontend origins allowed to make cross-origin requests.
# Must include protocol and full host. No trailing slashes. No wildcards.
# Example: FRONTEND_URL=https://uchqun-admin.netlify.app,https://uchqun-teacher.netlify.app
# Leaving this empty in production will block ALL cross-origin requests (fail-closed by design).
FRONTEND_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177

# CORS_DEV_OPEN=true — set ONLY in local dev to allow all origins (e.g. for quick frontend prototype).
# Never set in production or staging — production always uses the FRONTEND_URL allowlist.
# CORS_DEV_OPEN=true

# Database Sync (set to true to force recreate tables - use with caution!)
FORCE_SYNC=false

# Migration Secret (required for POST /api/migrations/run)
MIGRATION_SECRET=your-migration-secret-change-this

# OpenAI/OpenRouter Configuration (Optional - for AI chat assistant)
# Option 1: Use OpenAI directly
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-3.5-turbo

# Option 2: Use OpenRouter (supports multiple AI models)
# Get your API key from: https://openrouter.ai/keys
OPENAI_API_KEY=your-openrouter-api-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Free models (no credits needed): qwen/qwen-2.5-7b-instruct:free, deepseek/deepseek-r1-0528:free, meta-llama/llama-3.2-3b-instruct:free
# Paid models: gpt-3.5-turbo, gpt-4, claude-3-opus, claude-3-son        net, etc.
# If not set, will automatically try free models if credits are insufficient
OPENAI_MODEL=qwen/qwen-2.5-7b-instruct:free

# API base URL (used for generating file URLs when using local storage)
# In production set to your backend URL, e.g. https://uchqun-production-up.railway.app
# In development you can leave default (http://localhost:5000)
# API_URL=https://uchqun-production-up.railway.app

# Appwrite Storage Configuration
# Required for storing media files persistently in Appwrite
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-appwrite-project-id
APPWRITE_API_KEY=your-appwrite-api-key
APPWRITE_BUCKET_ID=your-appwrite-bucket-id

# Telegram Bot Configuration
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Channel or Group ID where bot will send messages (with @ prefix for public channels, or numeric ID for private)
# Example for public channel: @your_channel_name
# Example for private channel/group: -1001234567890
TELEGRAM_CHANNEL_ID=@your_channel_name_or_chat_id

# Payment Provider Configuration
# Payme (https://developer.help.paycom.uz/)
PAYME_MERCHANT_ID=your-payme-merchant-id
PAYME_MERCHANT_KEY=your-payme-merchant-key
PAYME_TEST_MODE=true

# Click (https://docs.click.uz/)
CLICK_MERCHANT_ID=your-click-merchant-id
CLICK_SERVICE_ID=your-click-service-id
CLICK_SECRET_KEY=your-click-secret-key
CLICK_MERCHANT_USER_ID=your-click-merchant-user-id

# Rate Limiting (RL-003)
# General API limiter — requests per IP per window. Default: 1000 / 15min.
# Raised from 500 to 1000; school staff browsing multiple pages easily exceeded the old default.
# RATE_LIMIT_API_MAX=1000
# RATE_LIMIT_WINDOW_MS=900000   # window in ms (15 min default, shared across most limiters)
# RATE_LIMIT_AUTH_MAX=50        # set-password, admin-register endpoints
# RATE_LIMIT_LOGIN_MAX=20       # per-email failed login attempts
# RATE_LIMIT_LOGIN_IP_MAX=100   # per-IP login guard (1 hour window)
# RATE_LIMIT_UPLOAD_MAX=100     # file upload limiter

# Redis Configuration (PL-007)
# REQUIRED for multi-instance production deploys. Without this, login lockout and JTI revocation
# fall back to in-memory (single-instance only — lost on restart, not shared across instances).
# Set to your Railway Redis URL: redis://default:<password>@<host>:<port>
# REDIS_URL=redis://default:your-redis-password@your-redis-host:6379

# Sentry Error Monitoring (PL-005)
# REQUIRED in production for error visibility. Without this, all production errors are invisible.
# Get your DSN from https://sentry.io → Project Settings → Client Keys.
# SENTRY_DSN=https://your-key@o0.ingest.sentry.io/your-project-id
